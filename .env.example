# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Postgres connection string (from Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# CORS — comma-separated list of allowed origins.
# Set this to your Chrome extension origin:
#   chrome-extension://<your-extension-id>
# For local development you may also add http://localhost
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here
